{
  "name": "pingflux",
  "version": "1.1.0",
  "description": "A lightweight, event-driven network diagnostics and observability SDK for Node.js",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "install": "node-gyp-build || node-gyp rebuild",
    "build": "tsc",
    "prebuilds": "prebuildify --napi --strip",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "native",
    "binding.gyp",
    "prebuilds"
  ],
  "keywords": [
    "network",
    "ping",
    "tcp",
    "udp",
    "dns",
    "http",
    "latency",
    "diagnostics"
  ],
  "author": "AmirVoid12 (https://github.com/AmirVoid12)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AmirVoid12/pingflux.git"
  },
  "bugs": {
    "url": "https://github.com/AmirVoid12/pingflux/issues"
  },
  "homepage": "https://github.com/AmirVoid12/pingflux#readme",
  "os": [
    "linux"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "engines": {
    "node": ">=16.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "prebuildify": "^6.0.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "node-gyp": "^13.0.2",
    "node-gyp-build": "^4.8.4"
  },
  "directories": {
    "test": "test"
  }
}
